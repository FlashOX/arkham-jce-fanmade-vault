  "cycles": {
    "Cycle 1": {
      "description": "Huit scénarios indépendants : deux créations francophones — Face au Wendigo et Pulsions Cynégétiques — et six traductions de scénarios anglophones : The Nephew Calls, The Festival, Happy's Funhouse, Bridge of Sighs, The Pensher Wyrm, et The Limens Belief. S'y ajoutent six enquêteurs fan-made."
    },
    "Cycle 2": {
      "description": "Huit scénarios indépendants : Désolation à Bord du Constellation, La Symphonie d'Erich Zann, Les Chiens de Tindalos, Au Bord du Gouffre, Sang versé à Salem, La Couleur tombée du Ciel, L'Événement de Svalbard et L'Hôtel du Grand Chêne. S'y ajoutent des enquêteurs fan-made et les cartes joueur lauréates du concours 2020."
    },
    "Cycle 3": {
      "description": "Troisième lot de scénarios fan-made. Détails sur le Discord de la communauté."
    },
    "Cycle 8": {
      "description": "Lot de scénarios fan-made numéroté « Cycle 8 ». Détails sur le Discord de la communauté."
    }
  },
